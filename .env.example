# Local Postgres from infra/compose.yaml (port bound to 127.0.0.1 only).
DATABASE_URL=postgres://hub:hub@127.0.0.1:5432/hub
# Hub HTTP server
HUB_PORT=7420
HUB_BASE_URL=http://localhost:7420
# Per-install token for the REST API, UI and HTTP MCP (spec §11.3): any random string, 24+ chars
HUB_LOCAL_TOKEN=change-me-to-a-long-random-token
# Better Auth secret (any long random string locally)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Optional: `hub import confluence-worklog` (read-only). With CONFLUENCE_USER the token is sent
# as Basic auth (Server/DC API token), otherwise as a Bearer personal access token.
# CONFLUENCE_BASE_URL=https://wiki.example.com
# CONFLUENCE_SPACE=MYSPACE
# CONFLUENCE_TOKEN=
# CONFLUENCE_USER=
