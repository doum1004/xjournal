{
  "name": "xjournal",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --env-file=.env --watch apps/server/src/main.ts",
    "start": "bun --env-file=.env apps/server/src/main.ts",
    "hub": "bun --env-file=.env apps/cli/src/main.ts",
    "migrate": "bun --env-file=.env apps/cli/src/main.ts migrate",
    "db:up": "docker compose -f infra/compose.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:generate": "cd packages/db && drizzle-kit generate --name",
    "typecheck": "tsc -p .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "test:pg": "HUB_TEST_DATABASE_URL=postgres://hub:hub@127.0.0.1:5432/hub bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
